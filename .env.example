# Server
PORT=3000
NODE_ENV=development

# OpenRouter (LLM)
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxx
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Tavily (Web Search) - Get free key at https://tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxx

# Fair Value API
FAIR_VALUE_API_URL=https://fairvalue-api.vercel.app
FAIR_VALUE_API_KEY=  # Optional, if endpoint is protected

# Output directory (where ticker folders will be created)
OUTPUT_DIR=.
